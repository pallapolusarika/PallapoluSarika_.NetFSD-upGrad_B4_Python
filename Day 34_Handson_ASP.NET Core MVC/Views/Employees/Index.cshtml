@model IEnumerable<EmployeeManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h2>Employee List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<!-- 🔍 Search + Filter + Sort -->
<form method="get" class="mb-3">
    <input type="text" name="searchString" placeholder="Search by name" class="form-control mb-2" />

    <input type="text" name="department" placeholder="Filter by department" class="form-control mb-2" />

    <select name="sortOrder" class="form-control mb-2">
        <option value="">Salary Ascending</option>
        <option value="salary_desc">Salary Descending</option>
    </select>

    <button type="submit" class="btn btn-success">Apply</button>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Job Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Department</td>
                <td>@item.Salary</td>
                <td>@item.HireDate.ToShortDateString()</td>
                <td>@item.JobStatus</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>